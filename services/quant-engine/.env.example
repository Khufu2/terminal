# Required for any non-loopback deployment. Use the same value as QUANT_ENGINE_API_KEY in the web app.
API_AUTH_KEY=replace-with-a-long-random-secret

# Recommended provider setup (Gemini)
LANGCHAIN_PROVIDER=gemini
LANGCHAIN_MODEL_NAME=gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Runtime persistence
VIBE_TRADING_RUNTIME_DIR=/data
